{
  "name": "@ppbong/cvss",
  "version": "1.0.0",
  "description": "Common Vulnerability Scoring System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppbong/cvss.git"
  },
  "author": "ppbong",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/cvss.d.ts",
  "scripts": {
    "test": "node test/test.js",
    "build": "tsc && copyfiles -f src\\cvss.d.ts lib",
